# Application
VITE_APP_NAME=Quantum Digital Labs

# Supabase (client talks to Supabase directly — no backend API)
# Both values are safe to expose in the client bundle (anon key is
# designed for this; Row Level Security enforces access control).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

