NODE_ENV=development
PORT=5050
CLIENT_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/quantum_db

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=quantumdigitallabsp@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM="Quantum Digital Labs <quantumdigitallabsp@gmail.com>"

# Seeded by `npm run db:seed` (change after first login in production)
# ADMIN_EMAIL=admin@quantumdigitallabs.com
# ADMIN_PASSWORD=Admin@12345
