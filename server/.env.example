NODE_ENV=development
PORT=5050
CLIENT_URL=http://localhost:5173

# Supabase (Postgres) — use the Session Pooler connection string for IPv4 compatibility
# Find it in: Supabase Dashboard → Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=quantumdigitallabsp@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM="Quantum Digital Labs <quantumdigitallabsp@gmail.com>"

# Seeded by `npm run db:seed` (change after first login in production)
# ADMIN_EMAIL=admin@quantumdigitallabs.com
# ADMIN_PASSWORD=Admin@12345
